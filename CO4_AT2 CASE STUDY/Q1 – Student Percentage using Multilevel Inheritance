#include <iostream>
using namespace std;

class Marks {
protected:
    float m1, m2, m3;
public:
    void accept() {
        cin >> m1 >> m2 >> m3;
    }
};

class Total : public Marks {
protected:
    float total;
public:
    void calculateTotal() {
        total = m1 + m2 + m3;
    }
};

class Percentage : public Total {
    float percentage;
public:
    void calculatePercentage() {
        percentage = total / 3;
    }
    void display() {
        cout << "Total Marks: " << total << endl;
        cout << "Percentage: " << percentage << "%";
    }
};

int main() {
    Percentage p;
    p.accept();
    p.calculateTotal();
    p.calculatePercentage();
    p.display();
    return 0;
}
